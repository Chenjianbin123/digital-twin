# --- 1. 数据来源 ---
# mock     = 本地假数据，无需后端
# remote   = 连接智慧病房设备端后端（需填下方 Host / Token）
# database = 可选的本地数据库适配器模式
VITE_DATA_SOURCE=remote

# --- 2. 真实设备端后端连接 ---
# Host：后端地址（填 IP 或完整 URL；dev 走 Vite 代理 /swp → 此地址）
VITE_DEVICE_HOST=192.168.96.104

# Token：由登录接口写入 sessionStorage.TokenKey，不在前端环境文件中固化
VITE_API_TOKEN=

# --- 3. 病区筛选（remote 模式可选，传给 querySwpDeviceInfo）---
# 不填则按 token 权限返回全部门口机；填则只查该病区
# VITE_AREA_ID=72
# VITE_DEPT_ID=

# --- 4. 接口参数（一般不用改）---
# apkSystemType：2 = Android（对齐 ApkSystemEnum）
VITE_APK_SYSTEM_TYPE=2

# menuMode：1=普通  2=医护（对齐 MenuModeEnum）
VITE_MENU_MODE=1
