# Copy these variables into your shell before running `npm run dev:db-adapter`.
# Do not prefix database credentials with VITE_, because VITE_* values are exposed to the browser.

DB_ADAPTER_PORT=8788
DB_ADAPTER_HOST=127.0.0.1
DB_HOST=192.168.96.104
DB_PORT=23306
DB_USER=root
DB_PASSWORD=
DB_NAME=dnk_swp_db
DB_DEFAULT_AREA_CODE=2001

# Use a stable, strong random secret so sessions remain valid across adapter restarts.
DB_AUTH_SECRET=
DB_AUTH_TTL_SECONDS=28800
DB_AUTH_PENDING_TTL_SECONDS=300

# true by default. Set to false only for trusted local debugging.
DB_MASK_PATIENT_NAME=true
